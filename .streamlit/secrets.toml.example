# Copie para .streamlit/secrets.toml (local) ou cole em "Secrets" no Streamlit Community Cloud.
# NUNCA faça commit do secrets.toml real (já está no .gitignore).

[sheets]
spreadsheet_id = "ID_DA_PLANILHA"   # o trecho entre /d/ e /edit na URL da planilha

[gcp_service_account]               # conteúdo do JSON da conta de serviço
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "sisescala@SEU-PROJETO.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
